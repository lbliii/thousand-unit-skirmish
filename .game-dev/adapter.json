{
  "schema": "game_dev.adapter.v1",
  "id": "thousand-unit-skirmish",
  "name": "Thousand Unit Skirmish",
  "version": "0.23.0",
  "scenarios": [
    {
      "id": "pathfinding-256",
      "title": "2,000-unit 256×256 pathfinding diagnostic",
      "command": {
        "executable": "scripts/pathfinding-scenario.mjs",
        "arguments": [
          "{param.map}",
          "{param.repeats}"
        ],
        "workingDirectory": "."
      },
      "parameters": {
        "map": {
          "type": "enum",
          "values": ["open", "choke"],
          "default": "open",
          "required": false
        },
        "repeats": {
          "type": "integer",
          "default": 2,
          "required": false,
          "minimum": 1,
          "maximum": 5,
          "description": "Number of 10-second movement and tick samples, from 1 to 5"
        }
      },
      "capabilities": ["cpu", "project-write", "performance"],
      "timeoutSeconds": 90,
      "outputs": {
        "format": "game-dev-capture-v1",
        "path": "capture.json"
      }
    },
    {
      "id": "choke-flow-2000",
      "title": "2,000-unit sustained Stone Pass flow",
      "command": {
        "executable": "scripts/pathfinding-scenario.mjs",
        "arguments": ["choke", "1", "60", "choke-flow"],
        "workingDirectory": "."
      },
      "capabilities": ["cpu", "project-write", "performance"],
      "timeoutSeconds": 120,
      "outputs": {
        "format": "game-dev-capture-v1",
        "path": "capture.json"
      }
    },
    {
      "id": "checkpoint-move-2000",
      "title": "2,000-unit movement with checkpointing",
      "command": {
        "executable": "scripts/checkpoint-performance-scenario.mjs",
        "arguments": ["12", "move", "3"],
        "workingDirectory": "."
      },
      "capabilities": ["cpu", "project-write", "performance"],
      "timeoutSeconds": 120,
      "outputs": {
        "format": "game-dev-capture-v1",
        "path": "capture.json"
      }
    },
    {
      "id": "checkpoint-attack-move-2000",
      "title": "2,000-unit attack-move with checkpointing",
      "command": {
        "executable": "scripts/checkpoint-performance-scenario.mjs",
        "arguments": ["12", "attack-move", "3"],
        "workingDirectory": "."
      },
      "capabilities": ["cpu", "project-write", "performance"],
      "timeoutSeconds": 120,
      "outputs": {
        "format": "game-dev-capture-v1",
        "path": "capture.json"
      }
    },
    {
      "id": "renderer-appearance-lod",
      "title": "Fog-safe mixed-role LOD appearance matrix",
      "command": {
        "executable": "scripts/renderer-appearance-lod-scenario.mjs",
        "arguments": [],
        "workingDirectory": "."
      },
      "timeoutSeconds": 180,
      "capabilities": ["cpu", "project-write", "gpu"],
      "outputs": {
        "format": "game-dev-capture-v1",
        "path": "capture.json"
      }
    },
    {
      "id": "browser-render-2000",
      "title": "2,000-unit browser performance sample with screenshot context",
      "command": {
        "executable": "scripts/browser-performance-scenario.mjs",
        "arguments": ["{param.durationSeconds}"],
        "workingDirectory": "."
      },
      "timeoutSeconds": 180,
      "capabilities": ["cpu", "project-write", "gpu", "performance"],
      "parameters": {
        "durationSeconds": {
          "type": "integer",
          "description": "Seconds per movement wave; three waves are measured",
          "required": false,
          "default": 10,
          "minimum": 10,
          "maximum": 40
        }
      },
      "outputs": {
        "format": "game-dev-capture-v1",
        "path": "capture.json"
      }
    },
    {
      "id": "renderer-environment-state-preflight",
      "title": "CPU preflight for environment resource and construction states",
      "command": {
        "executable": "scripts/renderer-environment-state-scenario.mjs",
        "arguments": ["--preflight"],
        "workingDirectory": "."
      },
      "capabilities": ["cpu", "project-write"],
      "timeoutSeconds": 60,
      "outputs": {
        "format": "game-dev-capture-v1",
        "path": "capture.json"
      }
    },
    {
      "id": "renderer-environment-state-pilot-plan",
      "title": "Plan four fog-safe environment pilot frames without capture",
      "command": {
        "executable": "scripts/renderer-environment-state-scenario.mjs",
        "arguments": ["--pilot-plan"],
        "workingDirectory": "."
      },
      "capabilities": ["cpu", "project-write"],
      "timeoutSeconds": 60,
      "outputs": {
        "format": "game-dev-capture-v1",
        "path": "capture.json"
      }
    },
    {
      "id": "renderer-environment-state-pilot",
      "title": "Four-frame fog-safe environment appearance pilot",
      "command": {
        "executable": "scripts/renderer-environment-state-scenario.mjs",
        "arguments": ["--pilot"],
        "workingDirectory": "."
      },
      "capabilities": ["cpu", "project-write", "gpu"],
      "timeoutSeconds": 600,
      "outputs": {
        "format": "game-dev-capture-v1",
        "path": "capture.json"
      }
    },
    {
      "id": "renderer-environment-state",
      "title": "Fog-safe resource and construction state appearance matrix",
      "command": {
        "executable": "scripts/renderer-environment-state-scenario.mjs",
        "arguments": [],
        "workingDirectory": "."
      },
      "capabilities": ["cpu", "project-write", "gpu"],
      "timeoutSeconds": 600,
      "outputs": {
        "format": "game-dev-capture-v1",
        "path": "capture.json"
      }
    }
  ]
}
